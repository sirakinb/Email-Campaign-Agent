# Copy to .env for LOCAL use. Never commit your filled-in .env.
# Website + database
PORT=8787
PUBLIC_URL=http://localhost:8787
DATABASE_URL=postgres://localhost/email_agent
APP_PASSWORD=
SESSION_SECRET=
# Required, even locally. Use the same random secret on server and worker.
AGENT_TOKEN=
OWNER_EMAIL=

# Claude worker (for separate machines, use apps/agent/.env.example instead).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
# Leave blank locally; set to the hosted dashboard URL for a remote server.
SWITCHBOARD_URL=
# Only when the server has an INSTABOX_BOX_ID; must match exactly.
AGENT_MACHINE_ID=

# Optional server integrations. Leave unused values blank.
ZOHO_CAMPAIGNS_MCP_URL=
ZOHO_CRM_MCP_URL=
# Prefer Settings > Campaign setup for your listings URL. This is a fallback.
LISTINGS_URL=
INSTABOX_API_KEY=
INSTABOX_BOX_ID=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
OWNER_PHONE=
FAL_KEY=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
COMPOSIO_API_KEY=
# Optional existing session to adopt; normally leave blank.
COMPOSIO_SESSION_ID=
