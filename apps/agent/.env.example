# Copy to apps/agent/.env ON THE WORKER COMPUTER. Never commit filled secrets.
SWITCHBOARD_URL=https://YOUR-APP-DOMAIN
AGENT_TOKEN=
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
# Leave blank unless the server has INSTABOX_BOX_ID; then use that exact ID.
AGENT_MACHINE_ID=
# Optional: persistent folder for Claude sessions and concurrency limit.
# AGENT_WORKDIR=/data/home/ea-workspace
# AGENT_MAX_PARALLEL=3
